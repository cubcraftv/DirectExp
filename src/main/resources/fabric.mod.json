{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "Experimental Fabric-delivered backend project for bringing a native DirectX 11 renderer (feature level 10.1 minimum) to Minecraft 26.2 on Windows.",
	"authors": [
		"cubcraftv"
	],
	"contact": {},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.cubcraftv.directexp.DirectExpMod"
		],
		"client": [
			"dev.cubcraftv.directexp.client.DirectExpClient"
		]
	},
	"mixins": [
		"directexp.mixins.json",
		{
			"config": "directexp.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
